# Copy to .env and fill in. Never commit .env.
RESY_EMAIL=you@example.com
RESY_PASSWORD=your-resy-password
# Alternative to email/password: the auth token from a logged-in resy.com session
# RESY_AUTH_TOKEN=

# Optional: phone push notifications via the free ntfy app (pick a hard-to-guess topic)
# NTFY_TOPIC=my-secret-resy-alerts-8k2j

# Optional: override if Resy rotates its public web API key
# RESY_API_KEY=
